# ==============================================================================
# git-grass Environment Variables Template
# Copy this file to .env:
#   cp .env.example .env   (macOS/Linux)
#   Copy-Item .env.example .env (PowerShell)
#
# NOTE: .env is in .gitignore so your private API keys are NEVER pushed to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud AI Backend Configuration (Render / Hosted API)
# ------------------------------------------------------------------------------
# Active AI provider: 'backboard' or 'fallback' (default: fallback)
AI_PROVIDER=backboard

# Your Backboard Secret API Key from https://app.backboard.io
# Leave blank to use zero-cost bundled fallback challenges automatically.
BACKBOARD_API_KEY=

# Backboard LLM Provider & Model (Defaults to low-cost Gemini Flash)
BACKBOARD_PROVIDER=google
BACKBOARD_MODEL=gemini-2.0-flash

# Hosted API Server Port (Defaults to 3000 on Render)
PORT=3000

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=15

# Cache TTL in milliseconds (1 hour)
CACHE_TTL_MS=3600000

# ------------------------------------------------------------------------------
# 2. Local CLI Configuration (Optional overrides)
# ------------------------------------------------------------------------------
# Point local CLI to your deployed Render URL (optional)
# GIT_GRASS_BACKEND_URL=https://git-grass-hosted-ai.onrender.com

# Local session server port (default: 4242)
# GIT_GRASS_PORT=4242

