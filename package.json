{
  "name": "git-grass",
  "version": "0.1.0",
  "description": "Your AI can write the code. It can't touch grass. Git-native outdoor-break enforcement tool.",
  "type": "module",
  "bin": {
    "git-grass": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "web",
    "challenges",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "git",
    "git-hook",
    "developer-wellness",
    "outdoor-break",
    "touch-grass",
    "cli",
    "health",
    "ai"
  ],
  "author": "Sneha Tiwari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sn3hhaa/git-grass.git"
  },
  "bugs": {
    "url": "https://github.com/sn3hhaa/git-grass/issues"
  },
  "homepage": "https://github.com/sn3hhaa/git-grass#readme",
  "dependencies": {
    "commander": "^13.1.0",
    "express": "^4.21.2",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

